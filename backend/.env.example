# AutoList AI Backend Environment Configuration
# Copy this file to .env and update the values

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=AutoList AI
APP_VERSION=1.0.0
DEBUG=True

# =============================================================================
# Security Settings
# =============================================================================
# JWT Secret Key - CHANGE THIS IN PRODUCTION!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars

# JWT Algorithm
ALGORITHM=HS256

# Token expiry in hours
ACCESS_TOKEN_EXPIRE_HOURS=24

# Encryption key for storing sensitive data (Shopify tokens)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=ZyHh_f1LysE2C8QQOPdn2V7sqdRBTwNjKs_YP7G44EE=

# =============================================================================
# Database Settings (MongoDB Atlas)
# =============================================================================
# MongoDB Atlas connection URI
# Get your connection string from: Atlas Dashboard -> Connect -> Drivers
# Replace <username>, <password>, and <cluster> with your actual values
MONGODB_URI=mongodb+srv://deveshshrivas060:Gq7mmeGubT8twoD8@cluster0.w8nmlpu.mongodb.net/

# Database name
MONGODB_DB_NAME=autolist_ai

# =============================================================================
# Shopify Settings
# =============================================================================
# Shopify API version
SHOPIFY_API_VERSION=2024-01

# =============================================================================
# AI/LLM Settings (Optional)
# =============================================================================
# Anthropic API key for Claude AI-assisted mapping
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# Redis Settings (Optional - for background tasks)
# =============================================================================
# REDIS_URL=redis://localhost:6379/0
